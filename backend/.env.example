# PostgreSQL connection
DATABASE_URL=postgresql://user:***@localhost:5432/hht_inventory

# Alternatively, use individual params:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hht_inventory
DB_USER=postgres
DB_PASSWORD=your_password_here

# Server
PORT=3001
NODE_ENV=development

# JWT secret — CHANGE THIS in production
JWT_SECRET=hht-inventory-dev-secret-change-in-production

# Admin credentials (used by seed-admin.js)
# In production: set these as environment variables
# In development: defaults to admin / Zikoa1421887
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Zikoa1421887

# CORS origin — set to frontend URL in production (e.g. https://example.com)
CORS_ORIGIN=*